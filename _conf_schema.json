{
  "chat_command": {
    "description": "对话内查询",
    "hint": "唤醒机器人后发送 context，直接回复当前对话的上下文占用率。",
    "type": "object",
    "items": {
      "enable_chat_command": {
        "description": "启用 context 查询",
        "hint": "不区分大小写，可带 / 前缀；回复不调用模型。",
        "type": "bool",
        "default": true
      }
    }
  },
  "refresh": {
    "description": "自动刷新",
    "hint": "控制 WebUI 数据刷新频率；启用每小时统计时至少每小时刷新一次。",
    "type": "object",
    "items": {
      "auto_refresh_enabled": {
        "description": "启用自动刷新",
        "hint": "启用每小时统计时会被强制开启。",
        "type": "bool",
        "default": true
      },
      "auto_refresh_interval": {
        "description": "刷新间隔（分钟）",
        "hint": "默认 60 分钟，范围 1–120；启用每小时统计时最多 60 分钟。",
        "type": "int",
        "default": 60,
        "slider": {
          "min": 1,
          "max": 120,
          "step": 1
        }
      }
    }
  },
  "history": {
    "description": "上下文统计",
    "hint": "每小时后台采样上下文用量，用于对话详情的曲线。",
    "type": "object",
    "items": {
      "enable_history_sampling": {
        "description": "启用每小时统计",
        "hint": "开启后插件会在每个整点后自动采样，不依赖看板是否打开。",
        "type": "bool",
        "default": true
      },
      "history_retention_days": {
        "description": "数据保留天数（0 = 永久）",
        "hint": "默认 30 天；填 0 表示永久保留，正数最多 365 天。",
        "type": "int",
        "default": 30,
        "slider": {
          "min": 0,
          "max": 365,
          "step": 1
        }
      }
    }
  },
  "charts": {
    "description": "详情曲线",
    "hint": "选择在对话详情中显示哪些曲线。",
    "type": "object",
    "items": {
      "show_usage_chart": {
        "description": "显示上下文用量曲线",
        "type": "bool",
        "default": true
      },
      "show_growth_chart": {
        "description": "显示上下文增量曲线",
        "type": "bool",
        "default": true
      }
    }
  },
  "compression_marker": {
    "description": "压缩阈值标记",
    "hint": "在进度条上标出压缩触发线。",
    "type": "object",
    "items": {
      "show_compression_marker": {
        "description": "显示标记",
        "type": "bool",
        "default": true
      },
      "compression_marker_percent": {
        "description": "阈值（%）",
        "hint": "默认 82，对应 AstrBot 文档中的约 82% 触发条件。",
        "type": "int",
        "default": 82,
        "slider": {
          "min": 1,
          "max": 100,
          "step": 1
        }
      }
    }
  },
  "appearance": {
    "description": "外观",
    "hint": "自定义看板的主色。",
    "type": "object",
    "items": {
      "theme_color": {
        "description": "主题色",
        "hint": "HTML 颜色代码，例如 #22c55e；默认绿色。",
        "type": "string",
        "default": "#22c55e"
      }
    }
  }
}
